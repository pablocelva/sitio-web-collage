---
import Badge from '../ui/Badge.astro';
import { ContactForm } from './ContactForm';
import type { ContactInfoData } from '@/lib/schemas/contact.schema';

interface Props {
  contactInfo: ContactInfoData;
}

const { contactInfo } = Astro.props;
---

<section id="contacto" class="section-padding contacto-section" aria-label="Contacto y encargo de obras">
  <div class="container">
    <div class="section-header">
      <Badge variant="terracotta">Contacto & Proyectos</Badge>
      <h2>Hablemos de tu Proyecto</h2>
      <p class="section-desc">
        ¿Te interesa adquirir una obra, coordinar un taller privado o encargar una ilustración personalizada?
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-info-col">
        <div class="info-block">
          <h3 class="info-title">Detalles del Estudio</h3>
          
          <div class="info-item">
            <div class="info-icon" aria-hidden="true">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <span class="info-label">Correo Electrónico</span>
              <a href={`mailto:${contactInfo.email}`} class="info-value-link">{contactInfo.email}</a>
            </div>
          </div>

          {contactInfo.phone && (
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <span class="info-label">Teléfono / WhatsApp</span>
                <span class="info-value">{contactInfo.phone}</span>
              </div>
            </div>
          )}

          <div class="info-item">
            <div class="info-icon" aria-hidden="true">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <span class="info-label">Ubicación</span>
              <span class="info-value">{contactInfo.location}</span>
            </div>
          </div>
        </div>

        <div class="social-block">
          <h4 class="social-title">Redes & Portafolios</h4>
          <div class="social-links-grid">
            {contactInfo.social_links.instagram && (
              <a href={contactInfo.social_links.instagram} target="_blank" rel="noopener noreferrer" class="social-card">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                <span>Instagram</span>
              </a>
            )}
            {contactInfo.social_links.behance && (
              <a href={contactInfo.social_links.behance} target="_blank" rel="noopener noreferrer" class="social-card">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm-1.7 6.4c-.4-.5-1.1-.7-2-.7-1 0-1.7.3-2.2.9-.5.6-.8 1.4-.8 2.4 0 1 .3 1.8.8 2.4.5.6 1.3.9 2.2.9.9 0 1.6-.3 2.1-.8.5-.5.7-1.3.8-2.2h-5.9c.1.5.3.8.6 1.1.3.3.7.4 1.2.4.6 0 1.1-.2 1.4-.7h1.8zm-4.9-2.5h3.9c-.1-.5-.3-.8-.6-1.1-.3-.3-.8-.4-1.3-.4-.5 0-1 .1-1.3.4-.4.3-.6.7-.7 1.1zm-6.6 4.7c.6.4 1.4.6 2.3.6 1 0 1.9-.3 2.5-.8.6-.6.9-1.3.9-2.3 0-.7-.2-1.3-.6-1.7-.4-.4-1-.7-1.7-.8.5-.2.9-.5 1.2-.9.3-.4.5-.9.5-1.5 0-.9-.3-1.6-.9-2.1-.6-.5-1.5-.7-2.6-.7H2v12h6.8c1 0 1.8-.2 2.4-.6zM5.5 6.8h2.3c.5 0 1 .1 1.3.3.3.2.4.6.4 1 0 .4-.1.7-.4.9-.3.2-.7.3-1.3.3H5.5V6.8zm0 5h2.6c.6 0 1.1.1 1.4.4.3.2.5.6.5 1.1 0 .5-.2.9-.5 1.1-.3.3-.8.4-1.5.4H5.5v-3z"/></svg>
                <span>Behance</span>
              </a>
            )}
            {contactInfo.social_links.pinterest && (
              <a href={contactInfo.social_links.pinterest} target="_blank" rel="noopener noreferrer" class="social-card">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.42 7.63 11.17-.11-.95-.2-2.42.04-3.47.22-.94 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 3.99-.28 1.19.6 2.16 1.78 2.16 2.13 0 3.78-2.25 3.78-5.49 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.2 0 1.03.4 2.13.9 2.73.1.12.11.23.08.35-.09.38-.3.1.22-1.22-.51-.05-.12-.17-.16-.3-.12-.82-.34-1.33-1.34-1.33-2.16 0-3.52 2.56-6.85 7.48-6.85 3.93 0 6.99 2.8 6.99 6.55 0 3.91-2.46 7.05-5.88 7.05-1.15 0-2.23-.6-2.6-1.3l-.71 2.7c-.26 1-.95 2.25-1.42 3 1.12.35 2.31.54 3.55.54 6.63 0 12-5.37 12-12S18.63 0 12 0z"/></svg>
                <span>Pinterest</span>
              </a>
            )}
            {contactInfo.social_links.linkedin && (
              <a href={contactInfo.social_links.linkedin} target="_blank" rel="noopener noreferrer" class="social-card">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                <span>LinkedIn</span>
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="contact-form-col">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>

<style>
  .contacto-section {
    background-color: var(--bg-primary);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 4rem;
    align-items: start;
  }

  .info-block {
    background: var(--bg-card);
    padding: 2rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
    margin-bottom: 2rem;
  }

  .info-title {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .info-icon {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    padding: 0.5rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    display: block;
  }

  .info-value {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .info-value-link {
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .info-value-link:hover {
    text-decoration: underline;
  }

  .social-block {
    background: var(--bg-card);
    padding: 2rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }

  .social-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .social-links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-light);
    border-radius: 2px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .social-card:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background-color: var(--accent-soft);
  }

  @media (max-width: 868px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

