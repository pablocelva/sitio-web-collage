---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import type { TallerItem } from '@/lib/schemas/talleres.schema';
import { getOptimizedImageUrl } from '@/lib/cloudinary';

interface Props {
  talleres: TallerItem[];
}

const { talleres } = Astro.props;
---

<section id="talleres" class="section-padding talleres-section" aria-label="Talleres y workshops de collage">
  <div class="container">
    <div class="section-header">
      <Badge variant="terracotta">Formación & Aprendizaje</Badge>
      <h2>Talleres & Masterclasses</h2>
      <p class="section-desc">
        Espacios creativos presenciales y virtuales para experimentar con el lenguaje del collage análogo.
      </p>
    </div>

    <div class="talleres-list">
      {talleres.map((taller) => (
        <Card class="taller-card">
          <div class="taller-grid">
            <div class="taller-image-container">
              <img
                src={getOptimizedImageUrl(taller.image, { width: 500, height: 350, crop: 'fill' })}
                alt={`Imagen del taller ${taller.title}`}
                class="taller-img"
                width="500"
                height="350"
                loading="lazy"
              />
            </div>

            <div class="taller-details">
              <div class="taller-tags">
                <Badge variant={taller.available ? 'sage' : 'outline'}>
                  {taller.available ? 'Cupos Disponibles' : 'Agotado'}
                </Badge>
                <span class="modality-tag">{taller.modality}</span>
              </div>

              <h3 class="taller-title">{taller.title}</h3>
              <p class="taller-date">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>{taller.date}</span>
                <span class="duration-badge">({taller.duration})</span>
              </p>

              <p class="taller-desc">{taller.description}</p>

              {taller.includes && taller.includes.length > 0 && (
                <div class="includes-block">
                  <span class="includes-title">Qué incluye:</span>
                  <ul class="includes-list">
                    {taller.includes.map((item) => (
                      <li>
                        <svg width="14" height="14" fill="none" stroke="var(--accent-primary)" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="taller-actions">
                <Button
                  href={taller.registration_url}
                  variant={taller.available ? 'primary' : 'outline'}
                  size="md"
                >
                  {taller.available ? 'Reservar Mi Lugar' : 'Consultar Lista de Espera'}
                </Button>
              </div>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
  .talleres-section {
    background-color: var(--bg-primary);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .talleres-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .taller-card {
    padding: 0;
  }

  .taller-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
  }

  .taller-image-container {
    height: 100%;
    min-height: 280px;
  }

  .taller-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .taller-details {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .taller-tags {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .modality-tag {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .taller-title {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .taller-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--accent-primary);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .duration-badge {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .taller-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .includes-block {
    margin-bottom: 2rem;
    background-color: var(--bg-primary);
    padding: 1rem 1.25rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }

  .includes-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .includes-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.5rem;
  }

  .includes-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .taller-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 900px) {
    .taller-grid {
      grid-template-columns: 1fr;
    }

    .taller-image-container {
      max-height: 240px;
    }

    .taller-actions {
      justify-content: flex-start;
    }
  }
</style>
