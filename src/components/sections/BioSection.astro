---
import Badge from '../ui/Badge.astro';
import type { BioData } from '@/lib/schemas/bio.schema';

interface Props {
  bio: BioData;
}

const { bio } = Astro.props;
---

<section id="bio" class="section-padding bio-section" aria-label="Biografía del artista">
  <div class="container">
    <div class="section-header text-center">
      <Badge variant="sage">Biografía & Trayectoria</Badge>
      <h2>Sobre la Artista</h2>
    </div>

    <div class="bio-grid">
      <div class="bio-image-col">
        <div class="avatar-card">
          <img
            src={bio.avatar_url}
            alt={`Retrato de ${bio.name}`}
            class="artist-avatar"
            width="500"
            height="500"
            loading="lazy"
          />
          <div class="avatar-caption">
            <span class="caption-name">{bio.name}</span>
            <span class="caption-loc">{bio.location}</span>
          </div>
        </div>
      </div>

      <div class="bio-text-col">
        <span class="artist-subheading">Estudio de Collage Análogo</span>
        <h3 class="bio-headline">{bio.title}</h3>
        <p class="bio-paragraph">{bio.bio_summary}</p>
        <p class="bio-paragraph">{bio.experience}</p>

        <!-- Bloque de Destacados & Credenciales -->
        <div class="bio-highlights">
          <div class="highlight-card highlight-terracotta">
            <div class="highlight-icon-box" aria-hidden="true">
              <svg width="22" height="22" fill="none" stroke="var(--accent-primary)" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/>
              </svg>
            </div>
            <div class="highlight-info">
              <h4 class="highlight-title">Especialidad Técnica</h4>
              <p class="highlight-desc">Collage análogo con papel vintage de época, narrativa botánica & técnica mixta.</p>
            </div>
          </div>

          <div class="highlight-card highlight-sage">
            <div class="highlight-icon-box" aria-hidden="true">
              <svg width="22" height="22" fill="none" stroke="var(--sage-accent)" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
            <div class="highlight-info">
              <h4 class="highlight-title">Exposiciones & Prensa</h4>
              <p class="highlight-desc">Muestras en Coquimbo, Santiago, Madrid y colaboraciones editoriales internacionales.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bio-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .text-center {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header h2 {
    margin-top: 0.5rem;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4rem;
    align-items: center;
  }

  .avatar-card {
    background: var(--bg-card);
    padding: 1.25rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
  }

  .artist-avatar {
    width: 100%;
    height: auto;
    border-radius: 2px;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

  .avatar-caption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .caption-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .caption-loc {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .artist-subheading {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-accent);
    margin-bottom: 0.5rem;
  }

  .bio-headline {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .bio-paragraph {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  /* Seccion de Destacados */
  .bio-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .highlight-card {
    background-color: var(--bg-card);
    padding: 1.75rem 1.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .highlight-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
  }

  .highlight-terracotta {
    border-top: 3px solid var(--accent-primary);
  }

  .highlight-sage {
    border-top: 3px solid var(--sage-accent);
  }

  .highlight-icon-box {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-light);
    width: 44px;
    height: 44px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .highlight-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .highlight-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 868px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .bio-highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
