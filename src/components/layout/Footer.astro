---
interface Props {
  email?: string;
  socialLinks?: Record<string, string>;
}

const {
  email = 'hola@milagonzalezcollage.art',
  socialLinks = {
    instagram: 'https://instagram.com/milagonzalez_collage',
    behance: 'https://behance.net/milagonzalezcollage',
    pinterest: 'https://pinterest.com/milagonzalezcollage',
    linkedin: 'https://linkedin.com/in/milagonzalezcollage',
  },
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container footer-content">
    <div class="footer-brand">
      <h2 class="footer-title">Mila González</h2>
      <p class="footer-subtitle">Estudio de Collage Análogo & Ilustración Botánica</p>
      <p class="footer-quote">
        "El recorte como acto poético; la composición como refugio para la memoria."
      </p>
    </div>

    <div class="footer-links">
      <h3 class="footer-heading">Navegación</h3>
      <ul>
        <li><a href="#bio">Biografía & Trayectoria</a></li>
        <li><a href="#statement">Statement Artístico</a></li>
        <li><a href="#series">Series de Collages</a></li>
        <li><a href="#talleres">Talleres & Workshops</a></li>
        <li><a href="#kit">Kit de Collage & Materiales</a></li>
        <li><a href="#contacto">Contacto & Encargos</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h3 class="footer-heading">Contacto</h3>
      <p class="footer-email">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
      <p class="footer-location">Estudio Coquimbo, Región de Coquimbo, Chile</p>
      
      <div class="social-icons" aria-label="Redes sociales de la artista">
        {socialLinks.instagram && (
          <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        )}
        {socialLinks.behance && (
          <a href={socialLinks.behance} target="_blank" rel="noopener noreferrer" aria-label="Behance">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm-1.7 6.4c-.4-.5-1.1-.7-2-.7-1 0-1.7.3-2.2.9-.5.6-.8 1.4-.8 2.4 0 1 .3 1.8.8 2.4.5.6 1.3.9 2.2.9.9 0 1.6-.3 2.1-.8.5-.5.7-1.3.8-2.2h-5.9c.1.5.3.8.6 1.1.3.3.7.4 1.2.4.6 0 1.1-.2 1.4-.7h1.8zm-4.9-2.5h3.9c-.1-.5-.3-.8-.6-1.1-.3-.3-.8-.4-1.3-.4-.5 0-1 .1-1.3.4-.4.3-.6.7-.7 1.1zm-6.6 4.7c.6.4 1.4.6 2.3.6 1 0 1.9-.3 2.5-.8.6-.6.9-1.3.9-2.3 0-.7-.2-1.3-.6-1.7-.4-.4-1-.7-1.7-.8.5-.2.9-.5 1.2-.9.3-.4.5-.9.5-1.5 0-.9-.3-1.6-.9-2.1-.6-.5-1.5-.7-2.6-.7H2v12h6.8c1 0 1.8-.2 2.4-.6zM5.5 6.8h2.3c.5 0 1 .1 1.3.3.3.2.4.6.4 1 0 .4-.1.7-.4.9-.3.2-.7.3-1.3.3H5.5V6.8zm0 5h2.6c.6 0 1.1.1 1.4.4.3.2.5.6.5 1.1 0 .5-.2.9-.5 1.1-.3.3-.8.4-1.5.4H5.5v-3z"/></svg>
          </a>
        )}
        {socialLinks.pinterest && (
          <a href={socialLinks.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.42 7.63 11.17-.11-.95-.2-2.42.04-3.47.22-.94 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 3.99-.28 1.19.6 2.16 1.78 2.16 2.13 0 3.78-2.25 3.78-5.49 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.2 0 1.03.4 2.13.9 2.73.1.12.11.23.08.35-.09.38-.3.1.22-1.22-.51-.05-.12-.17-.16-.3-.12-.82-.34-1.33-1.34-1.33-2.16 0-3.52 2.56-6.85 7.48-6.85 3.93 0 6.99 2.8 6.99 6.55 0 3.91-2.46 7.05-5.88 7.05-1.15 0-2.23-.6-2.6-1.3l-.71 2.7c-.26 1-.95 2.25-1.42 3 1.12.35 2.31.54 3.55.54 6.63 0 12-5.37 12-12S18.63 0 12 0z"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-content">
      <p>&copy; {currentYear} Mila González. Todos los derechos reservados.</p>
      <p class="footer-meta">Coquimbo, Chile</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3.5rem;
  }

  .footer-title {
    font-size: 1.8rem;
    margin-bottom: 0.25rem;
  }

  .footer-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .footer-quote {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    max-width: 380px;
    font-size: 0.95rem;
  }

  .footer-heading {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .footer-links a:hover {
    color: var(--accent-primary);
  }

  .footer-email {
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .footer-email a:hover {
    color: var(--accent-primary);
  }

  .footer-location {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-icons a {
    color: var(--text-secondary);
    padding: 0.4rem;
    border-radius: 50%;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .social-icons a:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-medium);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
