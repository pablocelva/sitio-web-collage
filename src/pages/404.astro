---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Seo from '@/components/layout/Seo.astro';
import Button from '@/components/ui/Button.astro';

import '@/styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <Seo title="Página No Encontrada (404) | Mila González" noindex={true} />
  </head>
  <body>
    <Header />
    <main class="not-found-main">
      <div class="container not-found-container">
        <span class="error-code">404</span>
        <h1 class="error-title">Fragmento Perdido en el Espacio</h1>
        <p class="error-desc">
          La página o recurso que estás buscando fue removido o ha cambiado de dirección.
        </p>
        <Button href="/" variant="primary" size="lg">
          Volver a la Galería Principal
        </Button>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .not-found-main {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
    text-align: center;
  }

  .error-code {
    font-family: var(--font-serif);
    font-size: 6rem;
    font-weight: 700;
    color: var(--accent-primary);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }

  .error-title {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .error-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 2rem auto;
  }
</style>

